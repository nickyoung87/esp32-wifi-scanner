#include <stdio.h>
#include "freertos/FreeRTOS.h"
#include "freertos/task.h"
#include "driver/gpio.h"

#define BLINK_GPIO 2

void app_main(void)
{
    gpio_reset_pin(BLINK_GPIO);
    gpio_set_direction(BLINK_GPIO, GPIO_MODE_OUTPUT);

    int led_state = 0;
    int total_seconds = 0;

    while (total_seconds <= 5000) {
        led_state = !led_state;
        gpio_set_level(BLINK_GPIO, led_state);
        printf("LED State changed to: %d (Time elapsed: %d ms)\n", led_state, total_seconds);

        vTaskDelay(500 / portTICK_PERIOD_MS);

        // FIXED: Now properly adds 500 every loop iteration
        total_seconds += 500; 
    }
    
    printf("Loop finished, turning LED off\n");
    
    // FIXED: You must physically write the 0 level to the pin to turn it off
    gpio_set_level(BLINK_GPIO, 0); 
    
    // FIXED: Keeps the chip alive and resting so it doesn't crash/restart
    while(1) {
        vTaskDelay(1000 / portTICK_PERIOD_MS);
    }
}
